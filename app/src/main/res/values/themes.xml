<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kumbuka" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/kb_primary</item>
    </style>

    <!--
      Native Android 12+ SplashScreen (via androidx.core:core-splashscreen for
      API 26-30 compatibility). One OS-owned launch sequence - the amber
      curve-draw animated icon on the brand teal background - replaces the
      old Compose splash route entirely, so there is no "icon, then a second
      separate intro" anymore. postSplashScreenTheme hands off to the normal
      app theme once MainActivity's keep-on-screen condition clears.
    -->
    <style name="Theme.Kumbuka.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kb_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">850</item>
        <item name="postSplashScreenTheme">@style/Theme.Kumbuka</item>
    </style>
</resources>
