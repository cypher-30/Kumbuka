<?xml version="1.0" encoding="utf-8"?>
<!-- Initial (undrawn) state of the animated splash icon: curve trimmed to nothing,
     sun scaled to zero. splash_icon_animated.xml drives both. Same geometry as
     splash_icon_static.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.15"
        android:scaleY="1.15"
        android:translateX="17.2"
        android:translateY="17.2">
        <path
            android:name="curve"
            android:pathData="M8,46C20,30 44,30 56,46"
            android:strokeColor="#F0B23E"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="5.5"
            android:trimPathEnd="0" />
        <group
            android:name="sun"
            android:pivotX="32"
            android:pivotY="22"
            android:scaleX="0"
            android:scaleY="0">
            <path
                android:fillColor="#F0B23E"
                android:pathData="M24,22a8,8 0 1,0 16,0a8,8 0 1,0 -16,0" />
        </group>
    </group>
</vector>
