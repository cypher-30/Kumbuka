<?xml version="1.0" encoding="utf-8"?>
<!-- Splash A: the curve draws, then the sun pops in. Total ~950ms, inside the
     1000ms limit the platform gives an animated splash icon. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_icon_base">
    <target
        android:name="curve"
        android:animation="@animator/splash_curve_draw" />
    <target
        android:name="sun"
        android:animation="@animator/splash_sun_pop" />
</animated-vector>
