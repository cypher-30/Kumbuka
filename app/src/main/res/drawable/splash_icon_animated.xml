<?xml version="1.0" encoding="utf-8"?>
<!-- One native launch sequence, no separate app-authored intro: the amber
     curve draws in, then the dot lands, on the same teal background the OS
     shows immediately at process start. Plays once; never replayed on hot
     resume/rotation (that is the OS's job, not ours - see MainActivity). -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon_base">
    <target android:name="curve">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1"
                android:duration="650"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:startOffset="650"
                android:duration="200"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
</animated-vector>
